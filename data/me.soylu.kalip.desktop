[Desktop Entry]
Type=Application
Name=kalıp
GenericName=Disk image writer
GenericName[tr]=İmaj yazıcı
Comment=Write Linux ISO and Raspberry Pi OS images to USB, SD or NVMe
Comment[tr]=Linux ISO ve Raspberry Pi OS imajlarını USB, SD veya NVMe'ye yazar
Exec=kalip %f
Icon=drive-removable-media
Terminal=false
Categories=System;Utility;
Keywords=usb;iso;image;sd;raspberry;flash;
MimeType=application/x-cd-image;application/x-raw-disk-image;
StartupNotify=true
