#!/usr/bin/env python3
"""kalip'in ayrıcalıklı işçisi. pkexec ile root olarak çağrılır.

Tek başına durur (kalip paketini import etmez) çünkü /usr/local/libexec altına
root'a ait olarak kurulur.

GUI'den gelen hiçbir iddiaya güvenilmez: hedef cihaz burada yeniden doğrulanır.
Asıl güvenlik kapısı budur, arayüzdeki filtreler yalnızca kullanıcı deneyimidir.

Protokol -- stdout, satır başına bir olay:
    S <mesaj>                 durum
    P <asama> <yapilan> <toplam>   ilerleme (toplam 0 = bilinmiyor)
    R <anahtar>=<deger>       sonuç bilgisi
    E <mesaj>                 hata
    D                         bitti
"""

from __future__ import annotations

import argparse
import fcntl
import gzip
import hashlib
import json
import lzma
import os
import shutil
import struct
import stat
import subprocess
import sys
import tempfile
import threading
import time
import zipfile

CHUNK = 4 << 20
PROGRESS_INTERVAL = 0.25

BLKGETSIZE64 = 0x80081272
BLKRRPART = 0x125F

PROTECTED_MOUNTS = frozenset(
    {"/", "/boot", "/boot/efi", "/boot/firmware", "/home", "/usr", "/var", "/nix", "[SWAP]"}
)
# Hiçbir koşulda imaj hedefi olamayacak aygıtlar. loop/md/dm burada YOK:
# onlar meşru hedef olabilir (dosya destekli test, RAID/LVM üstüne ham yazma)
# ve gerçek kapı zaten aşağıdaki bağlama noktası kontrolüdür. Arayüz bu
# aygıtları yine de listelemez -- bkz. kalip/devices.py.
VIRTUAL_PREFIXES = ("zram", "ram", "sr", "fd")

PI_MARKERS = ("config.txt", "cmdline.txt")

# lsblk bütün aygıtları böyle etiketler. loop dosya destekli olduğu için
# meşru bir hedeftir (test ve imaj dosyasına yazma).
WHOLE_DEVICE_TYPES = ("disk", "loop")


class HelperError(RuntimeError):
    pass


# İptal, sinyalle yapılamaz: süreç root, arayüz değil. Bunun yerine arayüz
# stdin'e CANCEL yazar ya da boruyu kapatır.
_abort = threading.Event()


def _stdin_is_pipe() -> bool:
    try:
        return stat.S_ISFIFO(os.fstat(0).st_mode)
    except OSError:
        return False


def _watch_for_cancel() -> None:
    try:
        for line in sys.stdin:
            if line.strip().upper() == "CANCEL":
                break
    except Exception:
        pass
    _abort.set()  # EOF de iptal sayılır: arayüz öldüyse yazmaya devam etme


def start_cancel_watch() -> None:
    if _stdin_is_pipe():
        threading.Thread(target=_watch_for_cancel, daemon=True).start()


def check_abort() -> None:
    if _abort.is_set():
        raise HelperError("İptal edildi — medyadaki veri yarım kaldı.")


def emit(line: str) -> None:
    sys.stdout.write(line + "\n")
    sys.stdout.flush()


def status(message: str) -> None:
    emit("S " + message)


def progress(stage: str, done: int, total: int | None) -> None:
    emit(f"P {stage} {done} {total or 0}")


def result(key: str, value) -> None:
    emit(f"R {key}={value}")


# --------------------------------------------------------------------------- #
# Hedef doğrulama
# --------------------------------------------------------------------------- #

def lsblk_tree() -> list[dict]:
    out = subprocess.run(
        ["lsblk", "-J", "-b", "-o", "NAME,PATH,SIZE,TYPE,MOUNTPOINTS,FSTYPE,RO"],
        capture_output=True, text=True, check=True,
    ).stdout
    return json.loads(out).get("blockdevices", [])


def collect_mounts(node: dict) -> list[str]:
    found = [m for m in (node.get("mountpoints") or []) if m]
    for child in node.get("children") or []:
        found.extend(collect_mounts(child))
    return found


def find_disk(device: str) -> dict:
    real = os.path.realpath(device)
    for node in lsblk_tree():
        if node.get("type") not in WHOLE_DEVICE_TYPES:
            continue
        if os.path.realpath(node.get("path", "")) == real:
            return node
    raise HelperError(f"{device} bütün bir blok aygıtı olarak bulunamadı.")


def assert_writable_target(device: str) -> dict:
    if not os.path.exists(device):
        raise HelperError(f"{device} yok.")

    node = find_disk(device)
    name = node.get("name", "")
    if name.startswith(VIRTUAL_PREFIXES):
        raise HelperError(f"{device} sanal bir aygıt, hedef olamaz.")
    if node.get("ro"):
        raise HelperError(f"{device} salt-okunur.")

    mounts = collect_mounts(node)
    blocked = sorted(set(mounts) & PROTECTED_MOUNTS)
    if blocked:
        raise HelperError(
            f"{device} sistem diski ({', '.join(blocked)} burada) — yazmayı reddediyorum."
        )
    return node


def unmount_all(node: dict) -> None:
    mounts = collect_mounts(node)
    if not mounts:
        return
    status(f"{len(mounts)} bağlı bölüm ayrılıyor")
    for mountpoint in mounts:
        if mountpoint == "[SWAP]":
            raise HelperError("Hedefte swap var — yazmayı reddediyorum.")
        subprocess.run(["umount", "--", mountpoint], capture_output=True, text=True)
    still = collect_mounts(find_disk(node["path"]))
    if still:
        raise HelperError("Bağlı kalan bölüm var: " + ", ".join(still))


def device_size(fd: int) -> int:
    buf = fcntl.ioctl(fd, BLKGETSIZE64, b"\0" * 8)
    return struct.unpack("Q", buf)[0]


# --------------------------------------------------------------------------- #
# Kaynak akışı
# --------------------------------------------------------------------------- #

def open_source(path: str, compression: str):
    if compression in ("none", "", None):
        return open(path, "rb"), None
    if compression == "xz":
        return lzma.open(path, "rb"), None
    if compression == "gzip":
        return gzip.open(path, "rb"), None
    if compression == "zip":
        zf = zipfile.ZipFile(path)
        members = [i for i in zf.infolist() if not i.is_dir()]
        if len(members) != 1:
            zf.close()
            raise HelperError("Zip içinde tek bir imaj dosyası bekleniyordu.")
        return zf.open(members[0], "r"), zf
    if compression == "zstd":
        if shutil.which("zstdcat") is None:
            raise HelperError("zstdcat bulunamadı (zstd paketi kurulu mu?).")
        proc = subprocess.Popen(
            ["zstdcat", "--", path], stdout=subprocess.PIPE, stderr=subprocess.DEVNULL
        )
        return proc.stdout, proc
    raise HelperError(f"bilinmeyen sıkıştırma: {compression}")


def close_source(stream, holder) -> None:
    try:
        stream.close()
    except Exception:
        pass
    if holder is None:
        return
    if isinstance(holder, subprocess.Popen):
        holder.kill()
        holder.wait()
    else:
        holder.close()


# --------------------------------------------------------------------------- #
# Yazma ve doğrulama
# --------------------------------------------------------------------------- #

def write_image(device: str, source: str, compression: str, hint: int) -> tuple[int, str]:
    stream, holder = open_source(source, compression)
    digest = hashlib.sha256()
    written = 0
    last_report = 0.0

    fd = os.open(device, os.O_WRONLY | os.O_CLOEXEC | os.O_EXCL)
    try:
        capacity = device_size(fd)
        result("device_size", capacity)
        if hint and hint > capacity:
            raise HelperError(
                f"İmaj cihazdan büyük: {hint} bayt > {capacity} bayt."
            )

        status("yazılıyor")
        while True:
            chunk = stream.read(CHUNK)
            if not chunk:
                break
            if written + len(chunk) > capacity:
                raise HelperError("İmaj cihaz kapasitesini aştı, yazma durduruldu.")
            check_abort()
            os.write(fd, chunk)
            digest.update(chunk)
            written += len(chunk)
            now = time.monotonic()
            if now - last_report >= PROGRESS_INTERVAL:
                progress("write", written, hint if hint >= written else 0)
                last_report = now

        progress("write", written, written)
        status("önbellek diske boşaltılıyor")
        os.fsync(fd)
        os.posix_fadvise(fd, 0, 0, os.POSIX_FADV_DONTNEED)
    finally:
        os.close(fd)
        close_source(stream, holder)

    return written, digest.hexdigest()


def verify_image(device: str, length: int, expected: str) -> None:
    status("doğrulanıyor")
    digest = hashlib.sha256()
    read_total = 0
    last_report = 0.0

    fd = os.open(device, os.O_RDONLY | os.O_CLOEXEC)
    try:
        # Sayfa önbelleğini değil diski okuduğumuzdan emin ol.
        os.posix_fadvise(fd, 0, 0, os.POSIX_FADV_DONTNEED)
        while read_total < length:
            want = min(CHUNK, length - read_total)
            check_abort()
            chunk = os.read(fd, want)
            if not chunk:
                raise HelperError("Cihaz beklenenden erken bitti.")
            digest.update(chunk)
            read_total += len(chunk)
            now = time.monotonic()
            if now - last_report >= PROGRESS_INTERVAL:
                progress("verify", read_total, length)
                last_report = now
    finally:
        os.close(fd)

    progress("verify", length, length)
    if digest.hexdigest() != expected:
        raise HelperError(
            "Doğrulama BAŞARISIZ — diske yazılan veri imajla aynı değil. Medya bozuk olabilir."
        )
    status("doğrulama tamam")


# --------------------------------------------------------------------------- #
# Pi OS tohumlama
# --------------------------------------------------------------------------- #

def reread_partitions(device: str) -> None:
    """Çekirdeğe yeni bölüm tablosunu okut.

    Hiçbir yolu zorunlu değildir: başarısız olsa bile bölüm düğümleri zaten
    oluşmuş olabilir, seed tarafı yine de bekleyip tekrar bakar. Bu yüzden
    burada hata fırlatılmaz -- eskiden partprobe kurulu değilse (parted paketi
    yoksa) FileNotFoundError except bloğunun içinden fırlıyor ve yazılmış bir
    medyada custom.toml adımını tümden düşürüyordu.
    """
    status("bölüm tablosu yeniden okunuyor")

    try:
        fd = os.open(device, os.O_RDONLY | os.O_CLOEXEC)
        try:
            fcntl.ioctl(fd, BLKRRPART, 0)
            return
        finally:
            os.close(fd)
    except OSError:
        pass

    # blockdev util-linux'ta, o da zaten sert bağımlılık. partprobe (parted)
    # olmayabilir -- varsa denenir, yoksa sessizce geçilir.
    for command in (["blockdev", "--rereadpt", device], ["partprobe", "--", device]):
        try:
            if subprocess.run(command, capture_output=True).returncode == 0:
                return
        except OSError:
            continue


def first_fat_partition(device: str) -> str | None:
    for _ in range(10):
        node = find_disk(device)
        for child in node.get("children") or []:
            if (child.get("fstype") or "").lower() in ("vfat", "fat", "fat32", "fat16"):
                return child.get("path")
        time.sleep(0.5)
        subprocess.run(["udevadm", "settle", "--timeout=5"], capture_output=True)
    return None


def seed_custom_toml(device: str, toml_path: str) -> bool:
    partition = first_fat_partition(device)
    if partition is None:
        result("pi_seeded", "no:fat-bolum-yok")
        return False

    mountpoint = tempfile.mkdtemp(prefix="kalip-bootfs-")
    try:
        proc = subprocess.run(
            ["mount", "-t", "vfat", "-o", "rw,umask=000", "--", partition, mountpoint],
            capture_output=True, text=True,
        )
        if proc.returncode != 0:
            result("pi_seeded", "no:mount-basarisiz")
            return False

        present = os.listdir(mountpoint)
        if not any(marker in present for marker in PI_MARKERS):
            result("pi_seeded", "no:pi-bootfs-degil")
            return False

        status("custom.toml bootfs'e yazılıyor")
        target = os.path.join(mountpoint, "custom.toml")
        with open(toml_path, "rb") as src, open(target, "wb") as dst:
            data = src.read()
            dst.write(data)
            dst.flush()
            os.fsync(dst.fileno())
        os.chmod(target, 0o644)
        result("pi_seeded", "yes")
        return True
    finally:
        subprocess.run(["umount", "--", mountpoint], capture_output=True)
        try:
            os.rmdir(mountpoint)
        except OSError:
            pass


# --------------------------------------------------------------------------- #

def main() -> int:
    parser = argparse.ArgumentParser(description="kalip ayrıcalıklı işçi")
    parser.add_argument("--device", required=True)
    parser.add_argument("--source", required=True)
    parser.add_argument("--compression", default="none")
    parser.add_argument("--payload-size", type=int, default=0)
    parser.add_argument("--verify", action="store_true")
    parser.add_argument("--toml", default="")
    args = parser.parse_args()

    if os.geteuid() != 0:
        emit("E Bu araç root olarak çalıştırılmalı (pkexec üzerinden çağrılır).")
        return 2

    start_cancel_watch()

    try:
        if not os.path.isfile(args.source):
            raise HelperError(f"Kaynak okunamadı: {args.source}")
        if args.toml and not os.path.isfile(args.toml):
            raise HelperError(f"custom.toml okunamadı: {args.toml}")

        status("hedef doğrulanıyor")
        node = assert_writable_target(args.device)
        unmount_all(node)

        written, digest = write_image(
            args.device, args.source, args.compression, args.payload_size
        )
        result("written", written)
        result("sha256", digest)

        if args.verify:
            verify_image(args.device, written, digest)

        reread_partitions(args.device)
        subprocess.run(["udevadm", "settle", "--timeout=15"], capture_output=True)

        if args.toml:
            seed_custom_toml(args.device, args.toml)

        status("tamamlandı")
        emit("D")
        return 0
    except HelperError as exc:
        emit(f"E {exc}")
        return 1
    except OSError as exc:
        if exc.errno == 16:  # EBUSY
            emit("E Cihaz meşgul — başka bir program kullanıyor olabilir (O_EXCL reddedildi).")
        else:
            emit(f"E {exc.strerror or exc} ({args.device})")
        return 1
    except KeyboardInterrupt:
        emit("E İptal edildi.")
        return 130


if __name__ == "__main__":
    sys.exit(main())
