#!/usr/bin/env python3
"""Ingot's privileged helper, started as root through pkexec.

It stands alone (it does not import the ingot package) because it is installed
under /usr/libexec, owned by root.

Nothing the interface claims is trusted: the target device is re-validated
here. This is the real safety gate; the interface's filters only shape the
user experience.

The helper never produces interface text. pkexec does not carry the session's
language into it, so it emits stable codes that the interface translates
(ingot/messages.py). English messages go to stderr for people running it by
hand.

Protocol -- stdout, one event per line:
    S <code> [argument]           status
    P <stage> <done> <total>      progress (total 0 = unknown)
    R <key>=<value>               result fact
    E <code> <json parameters>    error
    D                             done
"""

from __future__ import annotations

import argparse
import errno
import fcntl
import gzip
import hashlib
import json
import lzma
import os
import shutil
import stat
import struct
import subprocess
import sys
import tempfile
import threading
import time
import zipfile

CHUNK = 4 << 20
PROGRESS_INTERVAL = 0.25
# Data is forced onto the device every SYNC_INTERVAL bytes and progress only
# counts what has been forced. Without this the kernel took a whole ISO into
# the page cache within seconds: the bar reached 100% while almost nothing had
# reached the media, and the real write happened during the final fsync with
# no progress at all. It also keeps gigabytes of dirty pages out of memory and
# lets cancelling take effect promptly.
SYNC_INTERVAL = 32 << 20

BLKGETSIZE64 = 0x80081272
BLKRRPART = 0x125F

PROTECTED_MOUNTS = frozenset(
    {"/", "/boot", "/boot/efi", "/boot/firmware", "/home", "/usr", "/var", "/nix", "[SWAP]"}
)
# Devices that can never be an image target. loop/md/dm are deliberately
# absent: they can be legitimate targets (file-backed testing, raw writes onto
# RAID/LVM) and the real gate is the mount point check below. The interface
# does not list them anyway -- see ingot/devices.py.
VIRTUAL_PREFIXES = ("zram", "ram", "sr", "fd")

PI_MARKERS = ("config.txt", "cmdline.txt")

# How lsblk labels whole devices. loop is file-backed and a legitimate target
# (testing, writing into an image file).
WHOLE_DEVICE_TYPES = ("disk", "loop")


class HelperError(RuntimeError):
    """A failure reported to the interface as a stable code.

    The message is English text for someone running the helper by hand; the
    interface ignores it and translates the code instead.
    """

    def __init__(self, code: str, message: str, **params) -> None:
        super().__init__(message)
        self.code = code
        self.params = params


# Cancellation cannot use signals: the process is root and the interface is
# not. The interface writes CANCEL to stdin or closes the pipe instead.
_abort = threading.Event()


def _stdin_is_pipe() -> bool:
    try:
        return stat.S_ISFIFO(os.fstat(0).st_mode)
    except OSError:
        return False


def _watch_for_cancel() -> None:
    try:
        for line in sys.stdin:
            if line.strip().upper() == "CANCEL":
                break
    except Exception:
        pass
    _abort.set()  # EOF counts too: if the interface died, stop writing


def start_cancel_watch() -> None:
    if _stdin_is_pipe():
        threading.Thread(target=_watch_for_cancel, daemon=True).start()


def check_abort() -> None:
    if _abort.is_set():
        raise HelperError("cancelled", "cancelled; the data on the media is incomplete")


def emit(line: str) -> None:
    sys.stdout.write(line + "\n")
    sys.stdout.flush()


def status(code: str, argument: str = "") -> None:
    emit(f"S {code} {argument}".rstrip())


def progress(stage: str, done: int, total: int | None) -> None:
    emit(f"P {stage} {done} {total or 0}")


def result(key: str, value) -> None:
    emit(f"R {key}={value}")


def report_error(code: str, message: str, params: dict) -> None:
    emit(f"E {code} {json.dumps(params, ensure_ascii=False, sort_keys=True)}")
    print(f"ingot-helper: {message}", file=sys.stderr, flush=True)


# --------------------------------------------------------------------------- #
# Target validation
# --------------------------------------------------------------------------- #

def lsblk_tree() -> list[dict]:
    out = subprocess.run(
        ["lsblk", "-J", "-b", "-o", "NAME,PATH,SIZE,TYPE,MOUNTPOINTS,FSTYPE,RO"],
        capture_output=True, text=True, check=True,
    ).stdout
    return json.loads(out).get("blockdevices", [])


def collect_mounts(node: dict) -> list[str]:
    found = [m for m in (node.get("mountpoints") or []) if m]
    for child in node.get("children") or []:
        found.extend(collect_mounts(child))
    return found


def find_disk(device: str) -> dict:
    real = os.path.realpath(device)
    for node in lsblk_tree():
        if node.get("type") not in WHOLE_DEVICE_TYPES:
            continue
        if os.path.realpath(node.get("path", "")) == real:
            return node
    raise HelperError(
        "not_whole_device", f"{device} is not a whole block device", device=device
    )


def assert_writable_target(device: str) -> dict:
    if not os.path.exists(device):
        raise HelperError("device_missing", f"{device} does not exist", device=device)

    node = find_disk(device)
    if node.get("name", "").startswith(VIRTUAL_PREFIXES):
        raise HelperError("virtual_device", f"{device} is a virtual device", device=device)
    if node.get("ro"):
        raise HelperError("read_only", f"{device} is read-only", device=device)

    blocked = sorted(set(collect_mounts(node)) & PROTECTED_MOUNTS)
    if blocked:
        mounts = ", ".join(blocked)
        raise HelperError(
            "system_disk",
            f"{device} is a system disk ({mounts}); refusing to write",
            device=device,
            mounts=mounts,
        )
    return node


def unmount_all(node: dict) -> None:
    mounts = collect_mounts(node)
    if not mounts:
        return
    status("unmounting", str(len(mounts)))
    for mountpoint in mounts:
        if mountpoint == "[SWAP]":
            raise HelperError("swap_on_target", "the target has active swap; refusing to write")
        subprocess.run(["umount", "--", mountpoint], capture_output=True, text=True)
    still = collect_mounts(find_disk(node["path"]))
    if still:
        mounts = ", ".join(still)
        raise HelperError("still_mounted", f"still mounted: {mounts}", mounts=mounts)


def write_all(fd: int, data: bytes) -> None:
    """os.write may write fewer bytes than asked; keep going until all are out."""
    view = memoryview(data)
    while view:
        count = os.write(fd, view)
        if count <= 0:
            raise OSError(errno.EIO, "the device accepted no data")
        view = view[count:]


def commit_to_device(fd: int, start: int, end: int) -> None:
    """Force everything written so far onto the device, then drop [start, end)
    from the page cache so memory does not fill up with the image."""
    os.fdatasync(fd)
    if end > start:
        os.posix_fadvise(fd, start, end - start, os.POSIX_FADV_DONTNEED)


def device_size(fd: int) -> int:
    buf = fcntl.ioctl(fd, BLKGETSIZE64, b"\0" * 8)
    return struct.unpack("Q", buf)[0]


# --------------------------------------------------------------------------- #
# Source stream
# --------------------------------------------------------------------------- #

def open_source(path: str, compression: str):
    if compression in ("none", "", None):
        return open(path, "rb"), None
    if compression == "xz":
        return lzma.open(path, "rb"), None
    if compression == "gzip":
        return gzip.open(path, "rb"), None
    if compression == "zip":
        zf = zipfile.ZipFile(path)
        members = [i for i in zf.infolist() if not i.is_dir()]
        if len(members) != 1:
            zf.close()
            raise HelperError("zip_not_single", "the zip archive must hold exactly one image")
        return zf.open(members[0], "r"), zf
    if compression == "zstd":
        if shutil.which("zstdcat") is None:
            raise HelperError("zstdcat_missing", "zstdcat not found (install zstd)")
        proc = subprocess.Popen(
            ["zstdcat", "--", path], stdout=subprocess.PIPE, stderr=subprocess.DEVNULL
        )
        return proc.stdout, proc
    raise HelperError(
        "unknown_compression", f"unknown compression: {compression}", name=compression
    )


def close_source(stream, holder) -> None:
    try:
        stream.close()
    except Exception:
        pass
    if holder is None:
        return
    if isinstance(holder, subprocess.Popen):
        holder.kill()
        holder.wait()
    else:
        holder.close()


# --------------------------------------------------------------------------- #
# Writing and verification
# --------------------------------------------------------------------------- #

def write_image(device: str, source: str, compression: str, hint: int) -> tuple[int, str]:
    stream, holder = open_source(source, compression)
    digest = hashlib.sha256()
    written = 0
    last_report = 0.0

    fd = os.open(device, os.O_WRONLY | os.O_CLOEXEC | os.O_EXCL)
    try:
        capacity = device_size(fd)
        result("device_size", capacity)
        if hint and hint > capacity:
            raise HelperError(
                "image_too_large",
                f"the image is larger than the device: {hint} > {capacity} bytes",
                image=hint,
                capacity=capacity,
            )

        status("writing")
        synced = 0
        while True:
            chunk = stream.read(CHUNK)
            if not chunk:
                break
            if written + len(chunk) > capacity:
                raise HelperError(
                    "capacity_exceeded", "the image outgrew the device; writing stopped"
                )
            check_abort()
            write_all(fd, chunk)
            digest.update(chunk)
            written += len(chunk)
            if written - synced >= SYNC_INTERVAL:
                commit_to_device(fd, synced, written)
                synced = written
                now = time.monotonic()
                if now - last_report >= PROGRESS_INTERVAL:
                    progress("write", synced, hint if hint >= synced else 0)
                    last_report = now

        status("flushing")
        commit_to_device(fd, synced, written)
        os.fsync(fd)
        os.posix_fadvise(fd, 0, 0, os.POSIX_FADV_DONTNEED)
        progress("write", written, written)
    finally:
        os.close(fd)
        close_source(stream, holder)

    return written, digest.hexdigest()


def verify_image(device: str, length: int, expected: str) -> None:
    status("verifying")
    digest = hashlib.sha256()
    read_total = 0
    last_report = 0.0

    fd = os.open(device, os.O_RDONLY | os.O_CLOEXEC)
    try:
        # Make sure the device is read, not the page cache.
        os.posix_fadvise(fd, 0, 0, os.POSIX_FADV_DONTNEED)
        while read_total < length:
            want = min(CHUNK, length - read_total)
            check_abort()
            chunk = os.read(fd, want)
            if not chunk:
                raise HelperError("device_ended_early", "the device ended early")
            digest.update(chunk)
            read_total += len(chunk)
            now = time.monotonic()
            if now - last_report >= PROGRESS_INTERVAL:
                progress("verify", read_total, length)
                last_report = now
    finally:
        os.close(fd)

    progress("verify", length, length)
    if digest.hexdigest() != expected:
        raise HelperError(
            "verify_failed", "verification FAILED: the device does not match the image"
        )
    status("verified")


# --------------------------------------------------------------------------- #
# Raspberry Pi OS seeding
# --------------------------------------------------------------------------- #

def reread_partitions(device: str) -> None:
    """Make the kernel read the new partition table.

    No method is mandatory: even when all fail the partition nodes may already
    exist, and seeding waits and looks again. So nothing is raised here -- an
    earlier version called partprobe from inside an except block, and without
    parted installed its FileNotFoundError escaped and silently dropped the
    custom.toml step on an otherwise written card.
    """
    status("rereading_partitions")

    try:
        fd = os.open(device, os.O_RDONLY | os.O_CLOEXEC)
        try:
            fcntl.ioctl(fd, BLKRRPART, 0)
            return
        finally:
            os.close(fd)
    except OSError:
        pass

    # blockdev is in util-linux, already a hard dependency. partprobe (parted)
    # may be missing -- try it when present, skip it quietly otherwise.
    for command in (["blockdev", "--rereadpt", device], ["partprobe", "--", device]):
        try:
            if subprocess.run(command, capture_output=True).returncode == 0:
                return
        except OSError:
            continue


def first_fat_partition(device: str) -> str | None:
    for _attempt in range(10):
        node = find_disk(device)
        for child in node.get("children") or []:
            if (child.get("fstype") or "").lower() in ("vfat", "fat", "fat32", "fat16"):
                return child.get("path")
        time.sleep(0.5)
        subprocess.run(["udevadm", "settle", "--timeout=5"], capture_output=True)
    return None


def seed_custom_toml(device: str, toml_path: str) -> bool:
    partition = first_fat_partition(device)
    if partition is None:
        result("pi_seeded", "no:no-fat-partition")
        return False

    mountpoint = tempfile.mkdtemp(prefix="ingot-bootfs-")
    try:
        proc = subprocess.run(
            ["mount", "-t", "vfat", "-o", "rw,umask=000", "--", partition, mountpoint],
            capture_output=True, text=True,
        )
        if proc.returncode != 0:
            result("pi_seeded", "no:mount-failed")
            return False

        present = os.listdir(mountpoint)
        if not any(marker in present for marker in PI_MARKERS):
            result("pi_seeded", "no:not-pi-bootfs")
            return False

        status("seeding")
        target = os.path.join(mountpoint, "custom.toml")
        with open(toml_path, "rb") as src, open(target, "wb") as dst:
            dst.write(src.read())
            dst.flush()
            os.fsync(dst.fileno())
        os.chmod(target, 0o644)
        result("pi_seeded", "yes")
        return True
    finally:
        subprocess.run(["umount", "--", mountpoint], capture_output=True)
        try:
            os.rmdir(mountpoint)
        except OSError:
            pass


# --------------------------------------------------------------------------- #

def main() -> int:
    parser = argparse.ArgumentParser(description="Ingot privileged helper")
    parser.add_argument("--device", required=True)
    parser.add_argument("--source", required=True)
    parser.add_argument("--compression", default="none")
    parser.add_argument("--payload-size", type=int, default=0)
    parser.add_argument("--verify", action="store_true")
    parser.add_argument("--toml", default="")
    args = parser.parse_args()

    if os.geteuid() != 0:
        report_error("not_root", "must run as root (it is started through pkexec)", {})
        return 2

    start_cancel_watch()

    try:
        if not os.path.isfile(args.source):
            raise HelperError(
                "source_missing", f"cannot read the image: {args.source}", path=args.source
            )
        if args.toml and not os.path.isfile(args.toml):
            raise HelperError(
                "toml_missing", f"cannot read custom.toml: {args.toml}", path=args.toml
            )

        status("validating_target")
        node = assert_writable_target(args.device)
        unmount_all(node)

        written, digest = write_image(
            args.device, args.source, args.compression, args.payload_size
        )
        result("written", written)
        result("sha256", digest)

        if args.verify:
            verify_image(args.device, written, digest)

        reread_partitions(args.device)
        subprocess.run(["udevadm", "settle", "--timeout=15"], capture_output=True)

        if args.toml:
            seed_custom_toml(args.device, args.toml)

        status("done")
        emit("D")
        return 0
    except HelperError as exc:
        report_error(exc.code, str(exc), exc.params)
        return 1
    except OSError as exc:
        if exc.errno == errno.EBUSY:
            report_error(
                "device_busy",
                f"{args.device} is busy (O_EXCL was refused)",
                {"device": args.device},
            )
        else:
            error = exc.strerror or str(exc)
            report_error(
                "os_error", f"{error} ({args.device})", {"error": error, "device": args.device}
            )
        return 1
    except KeyboardInterrupt:
        report_error("interrupted", "interrupted", {})
        return 130


if __name__ == "__main__":
    sys.exit(main())
